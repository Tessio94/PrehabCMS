{
  "name": "prehab-payload",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "payload": "payload",
    "generate:types": "payload generate:types",
    "generate:importmap": "payload generate:importmap",
    "db:migrate": "payload migrate",
    "db:status": "payload migrate:status",
    "db:create-migration": "payload migrate:create",
    "seed": "node --import tsx scripts/seed.ts",
    "maintenance": "node --import tsx scripts/maintenance.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:integration": "node --import tsx --test --test-force-exit tests/integration/*.test.ts",
    "test:local": "node --import tsx scripts/verify-local.ts",
    "test:http": "node --import tsx scripts/verify-local.ts --http"
  },
  "dependencies": {
    "@fancyapps/ui": "^6.1.14",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource-variable/oswald": "^5.2.8",
    "@payloadcms/db-postgres": "3.92.1",
    "@payloadcms/next": "3.92.1",
    "@payloadcms/richtext-lexical": "3.92.1",
    "@payloadcms/translations": "3.92.1",
    "clsx": "^2.1.1",
    "embla-carousel-react": "^8.6.0",
    "graphql": "^16.11.0",
    "luxon": "^3.7.2",
    "motion": "^12.39.0",
    "next": "16.4.3",
    "nodemailer": "10.2.1",
    "payload": "3.92.1",
    "pg": "^8.16.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-icons": "^5.6.0",
    "schema-dts": "^2.0.0",
    "sharp": "0.35.5",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.13",
    "@electric-sql/pglite-socket": "0.2.16",
    "@next/swc-wasm-nodejs": "^16.4.3",
    "@playwright/test": "^1.56.0",
    "@tailwindcss/postcss": "^4",
    "@types/luxon": "^3.7.1",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "^4",
    "tsx": "^4.20.6",
    "typescript": "^5"
  },
  "type": "module",
  "engines": {
    "node": "^22.23.4 || >=24.22.1"
  },
  "overrides": {
    "dompurify": "3.4.17",
    "happy-dom": "21.0.4",
    "js-yaml": "4.3.2",
    "source-map-js": "1.2.2",
    "baseline-browser-mapping": "2.11.34",
    "esbuild": "0.28.2",
    "graphql-scalars": "2.0.1"
  }
}
