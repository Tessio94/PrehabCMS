# Node 24.22.1+; copy this file to .env and replace the placeholders.
DATABASE_URL=postgresql://prehab:replace-with-a-long-database-password@localhost:5432/prehab
DATABASE_POOL_SIZE=10
POSTGRES_USER=prehab
POSTGRES_PASSWORD=replace-with-a-long-database-password
POSTGRES_DB=prehab
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=replace-with-at-least-32-random-characters
SERVER_URL=http://localhost:3000
# Seed script creates the first admin. Never commit real credentials.
ADMIN_EMAIL=admin@example.hr
ADMIN_PASSWORD=replace-with-a-unique-password-at-least-16-chars
ADMIN_NAME=Prehab administrator
# Optional SMTP: enables password reset and booking receipts. No patient data is logged.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Set ONLY to a header overwritten by your trusted reverse proxy, e.g. x-real-ip.
# Empty means all requests share a conservative global rate limit.
TRUSTED_IP_HEADER=
# Persistent directory. Never use an ephemeral filesystem in production.
MEDIA_DIR=./media
